{
  "name": "nanites",
  "version": "1.0.0",
  "description": "MCP server that lets Claude control a local LM Studio instance and delegate bounded sub-agent work to local models.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nanites": "./dist/index.js",
    "nanites-router": "./dist/router/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs && node scripts/copy-skill.mjs && node scripts/copy-server.mjs",
    "start": "node dist/index.js",
    "router": "node dist/router/main.js",
    "ui": "node dist/ui/main.js",
    "dev": "tsx watch src/index.ts",
    "dev:router": "tsx watch src/router/main.ts",
    "dev:ui": "tsx watch src/ui/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "live-smoke": "tsx scripts/live-smoke-test.ts",
    "live-feature": "tsx scripts/live-feature-test.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
